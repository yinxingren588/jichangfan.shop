---
import Base from '../../layouts/Base.astro';import {airports,money,monthlyPlan,traffic} from '../../data/airports';
---
<Base title="机场与 VPN 横向比较工具：价格、流量、协议与限制" description="选择 2–4 家真实品牌横向对比月付价格、流量、每 GB 成本、节点、协议、设备和 AI 与流媒体资料，所有数据来自统一数据库。" breadcrumbs={[{name:'机场对比',url:'/compare/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">COMPARE BEFORE YOU CHOOSE</div><h1>把选择，放在同一张表里。</h1><p>选择 2–4 个候选品牌比较。未知字段保留“尚未核实”，不限量方案不计算每 GB 为零；不同币种直接展示原币金额。</p></header><noscript><p class="note">当前未启用 JavaScript，下方仍可阅读完整静态数据表。选择候选品牌需要启用 JavaScript。</p></noscript><fieldset style="border:0;padding:0;margin:0"><legend>添加候选品牌（最多 4 家）</legend><div class="compare-picker">{airports.map(a=><label><input type="checkbox" value={a.slug} name="brand"/>{a.name}</label>)}</div></fieldset><p id="compare-status" class="status-message" role="status" aria-live="polite">选择至少 2 家后开始比较。</p><div id="compare-empty" class="empty" hidden>还差一个候选品牌。选择至少 2 家，最多 4 家。</div><div id="compare-table" class="table-wrap" tabindex="0" role="region" aria-label="品牌横向对比表，可横向滚动"><table class="compare-table"><thead><tr><th scope="col">比较维度</th>{airports.map(a=><th scope="col">{a.name}</th>)}</tr></thead><tbody>{[['服务类型',airports.map(a=>a.kind==='proxy'?'代理订阅':'商业 VPN')],['普通月付',airports.map(a=>{const p=monthlyPlan(a);return p?money(p.price,p.currency):'尚未核实';})],['套餐流量',airports.map(a=>traffic(monthlyPlan(a)))],['每 GB 实际成本',airports.map(a=>monthlyPlan(a)?.unlimited?'不适用（不限量）':'尚未核实（倍率或配额缺失）')],['节点地区',airports.map(a=>a.regions.join('、')||'完整地区列表尚未核实')],['协议',airports.map(a=>a.protocols.join('、')||'尚未核实')],['设备限制',airports.map(a=>a.deviceLimit||'尚未核实')],['AI 支持',airports.map(a=>a.aiSupport?.join('；')||'尚未核实')],['流媒体支持',airports.map(a=>a.streamingSupport?.join('；')||'尚未核实')],['优点',airports.map(a=>a.advantages.join('；'))],['注意事项',airports.map(a=>a.disadvantages.join('；'))]].map(([label,values])=><tr><th scope="row">{label}</th>{(values as string[]).map(v=><td>{v}</td>)}</tr>)}</tbody></table></div><p class="note">完整表格随 HTML 提供，搜索引擎与关闭脚本的读者都能阅读。交互筛选仅改变当前显示列，不生成可索引的重复页面。</p><div class="page-nav"><a href="/airport/">核对官方来源 →</a><a href="/ranking/budget/">普通月付预算榜 →</a><a href="/ranking/value/">性价比怎么计算 →</a></div></div><script>
import {airports,money,monthlyPlan,traffic,unitCost} from '../../data/airports';
const boxes=Array.from(document.querySelectorAll<HTMLInputElement>('input[name=brand]'));const status=document.querySelector('#compare-status')!;const empty=document.querySelector<HTMLElement>('#compare-empty')!;const container=document.querySelector<HTMLElement>('#compare-table')!;
function update(){const selected=boxes.filter(b=>b.checked).map(b=>b.value);status.textContent='已选择 '+selected.length+' / 4 家'+(selected.length<2?'；请再添加候选品牌。':'；可在表头移除品牌。');empty.hidden=selected.length>=2;container.hidden=selected.length<2;const url=new URL(location.href);if(selected.length)url.searchParams.set('brands',selected.join(','));else url.searchParams.delete('brands');history.replaceState(null,'',url.pathname+url.search);
const brands=selected.map(s=>airports.find(a=>a.slug===s)!);const table=document.createElement('table');table.className='compare-table';const head=table.createTHead().insertRow();const first=document.createElement('th');first.scope='col';first.textContent='比较维度';head.append(first);brands.forEach(a=>{const th=document.createElement('th');th.scope='col';const text=document.createElement('div');text.textContent=a.name;const remove=document.createElement('button');remove.className='remove-brand';remove.textContent='移除';remove.setAttribute('aria-label','移除 '+a.name);remove.addEventListener('click',()=>{boxes.find(b=>b.value===a.slug)!.checked=false;update();boxes.find(b=>b.value===a.slug)!.focus();});th.append(text,remove);head.append(th);});const body=table.createTBody();const fields:[string,(a:typeof airports[number])=>string][]=[['服务类型',a=>a.kind==='proxy'?'代理订阅':'商业 VPN'],['普通月付',a=>{const p=monthlyPlan(a);return p?money(p.price,p.currency)+' / 月':'尚未核实';}],['套餐流量',a=>traffic(monthlyPlan(a))],['每 GB 实际成本',a=>{const p=monthlyPlan(a);const cost=p?unitCost(p):undefined;return cost===undefined?(p?.unlimited?'不适用（不限量）':'尚未核实（倍率或配额缺失）'):cost.toFixed(5);}],['节点地区',a=>a.regions.join('、')||'完整地区列表尚未核实'],['协议',a=>a.protocols.join('、')||'尚未核实'],['设备限制',a=>a.deviceLimit||'尚未核实'],['AI 支持',a=>a.aiSupport?.join('；')||'尚未核实'],['流媒体支持',a=>a.streamingSupport?.join('；')||'尚未核实'],['优点',a=>a.advantages.join('；')],['注意事项',a=>a.disadvantages.join('；')],['最后核验',a=>a.lastVerified||'尚未核实']];fields.forEach(([label,format])=>{const row=body.insertRow();const th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);brands.forEach(a=>{const td=row.insertCell();td.textContent=format(a);});});const row=body.insertRow();const th=document.createElement('th');th.scope='row';th.textContent='来源与分析';row.append(th);brands.forEach(a=>{const link=document.createElement('a');link.href='/review/'+a.slug+'/';link.className='text-link';link.textContent='阅读 '+a.name+' 分析 →';row.insertCell().append(link);});container.replaceChildren(table);}
boxes.forEach(box=>box.addEventListener('change',()=>{if(boxes.filter(b=>b.checked).length>4){box.checked=false;status.textContent='最多比较 4 家，请先移除一个候选品牌。';return;}update();}));const initial=new URL(location.href).searchParams.get('brands')?.split(',')||[];const valid=[...new Set(initial)].filter(s=>airports.some(a=>a.slug===s)).slice(0,4);boxes.forEach(b=>b.checked=valid.includes(b.value));update();
</script></Base>

---
import BlogArchive from '../../components/BlogArchive.astro';import {getCollection} from 'astro:content';
const entries=(await getCollection('articles',({data})=>data.category==='blog'&&!data.draft)).sort((a,b)=>(a.data.order??0)-(b.data.order??0)||a.id.localeCompare(b.id));
---
<BlogArchive entries={entries.slice(0,20)} total={entries.length} totalPages={Math.ceil(entries.length/20)}/>

---
import {displayPlan,priceLabel,traffic,evidenceLabel,type Airport} from '../data/airports';
import Promotion from './Promotion.astro';
const {airport:a}=Astro.props as {airport:Airport};const p=displayPlan(a);
---
<article class="card"><div class="brand-head"><span class="brand-icon" style={'background:'+a.color} aria-hidden="true">{a.monogram}</span><div><h3>{a.name}</h3><small>{evidenceLabel(a)}</small></div></div><p>{a.description}</p><div class="price">{priceLabel(p)}</div><div class="specs"><span>{traffic(p)}</span><span>{a.plans.length} 档套餐</span></div><p style="margin-top:12px;font-size:11px">留意：{a.disadvantages[0]}</p><a class="text-link" href={'/airport/'+a.slug+'/'}>全部套餐与来源 <span aria-hidden="true">↗</span></a><Promotion airport={a} compact/></article>

---
import Base from '../../layouts/Base.astro';import BrandCard from '../../components/BrandCard.astro';import {airports} from '../../data/airports';
---
<Base title="机场与 VPN 品牌资料库：官方价格、协议和设备限制" description="查看 Just My Socks、Mullvad、IVPN、Proton VPN 与 Windscribe 五个真实品牌的官方资料，按代理订阅和商业 VPN 筛选并核对来源。" breadcrumbs={[{name:'品牌资料库',url:'/airport/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">BRAND DIRECTORY</div><h1>有来源的资料，更方便比较。</h1><p>每项信息记录来源和核验日期。代理订阅与商业 VPN 分开标注；未知字段显示尚未核实，本站没有实际购买与测速记录。</p></header><div class="filters" role="group" aria-label="筛选服务类型"><button class="filter" data-kind="all" aria-pressed="true">全部品牌</button><button class="filter" data-kind="proxy" aria-pressed="false">代理订阅</button><button class="filter" data-kind="vpn" aria-pressed="false">商业 VPN</button></div><p class="status-message" role="status" id="brand-count">显示 5 个品牌</p><div class="cards">{airports.map(a=><div data-brand-kind={a.kind}><BrandCard airport={a}/></div>)}</div></div><script>document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-kind]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;document.querySelectorAll<HTMLElement>('[data-brand-kind]').forEach(card=>{card.hidden=button.dataset.kind!=='all'&&button.dataset.kind!==card.dataset.brandKind;if(!card.hidden)count++;});document.querySelector('#brand-count')!.textContent='显示 '+count+' 个品牌';}));</script></Base>

---
import Base from '../../layouts/Base.astro';import {topics} from '../../data/topics';import {airports} from '../../data/airports';import BrandCard from '../../components/BrandCard.astro';
---
<Base title="机场推荐中心：按预算、设备与使用场景选择" description="从低预算、新手入门、高端线路、稳定性、AI 与流媒体六类需求出发，理解机场与 VPN 选择条件，查看有官方来源的品牌资料。" breadcrumbs={[{name:'机场推荐',url:'/recommend/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">RECOMMENDATION GUIDE</div><h1>先弄清需求，再看机场推荐。</h1><p>“最好用”取决于你的设备、预算与使用场景。下面六条阅读路径帮助你缩小范围；资料库同时收录代理订阅与商业 VPN，类型分别标注。</p></header><div class="catalog-grid">{topics.map(t=><a class="card" href={'/recommend/'+t.slug+'/'}><span class="pill">{t.tag}</span><h2 style="font-size:22px;margin-top:14px">{t.name} <span aria-hidden="true">↗</span></h2><p>{t.description}{t.subtitle}</p><span class="text-link">阅读选择方法 →</span></a>)}</div><section class="section" style="margin-top:36px"><div class="section-heading"><h2>从可核对的品牌资料开始</h2><a href="/ranking/">查看排行依据 ↗</a></div><div class="cards">{airports.slice(0,3).map(a=><BrandCard airport={a}/>)}</div></section></div></Base>

---
import '../styles/global.css';
import {site,nav} from '../data/site';
interface Props {title:string;description:string;breadcrumbs?:{name:string;url:string}[];noindex?:boolean;schema?:Record<string,unknown>[];date?:string;}
const {title,description,breadcrumbs=[],noindex=false,schema=[],date=site.date}=Astro.props;
const canonical=new URL(Astro.url.pathname==='/404.html'?'/404/':Astro.url.pathname,site.url).href;
const schemas=[{'@context':'https://schema.org','@type':'Organization','@id':site.url+'/#organization',name:site.name,url:site.url,logo:site.url+'/favicon.svg'},{'@context':'https://schema.org','@type':'WebSite','@id':site.url+'/#website',name:site.name,url:site.url,inLanguage:'zh-CN'},...(breadcrumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{name:'首页',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.url).href}))}]:[]),...schema];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | 机场翻</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta name="theme-color" content="#2563eb"/><meta property="og:type" content={schema.some(s=>s['@type']==='BlogPosting')?'article':'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content={site.name}/><meta property="og:image" content={site.url+'/social.png'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={site.url+'/social.png'}/><meta name="last-modified" content={date}/>{import.meta.env.BING_SITE_VERIFICATION&&<meta name="msvalidate.01" content={import.meta.env.BING_SITE_VERIFICATION}/>}<script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g,'\u003c')}/></head><body><a class="skip" href="#main">跳到正文</a><div class="topbar"><div class="container"><span>独立资料整理 · 理性选择网络服务</span><span class="secondary-text">可追溯来源 / 透明比较 / 持续更新</span></div></div><header class="header"><div class="container header-row"><a class="logo" href="/" aria-label="机场翻首页"><span class="logo-icon" aria-hidden="true">翻</span><span class="logo-text">机场翻<small>JICHANGFAN</small></span></a><button class="menu-button" aria-controls="primary-nav" aria-expanded="false">菜单 ☰</button><nav id="primary-nav" class="nav" aria-label="主导航">{nav.map(([label,url])=><a class:list={{active:url==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(url)}} href={url} aria-current={(url==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(url))?'page':undefined}>{label}</a>)}</nav><a href="/search/" class="search-link" aria-label="搜索文章与品牌">⌕ 搜索</a></div></header><main id="main"><div class="container">{breadcrumbs.length>0&&<nav class="breadcrumb" aria-label="面包屑"><a href="/">首页</a>{breadcrumbs.map((b,i)=><><span aria-hidden="true">/</span>{i===breadcrumbs.length-1?<span aria-current="page">{b.name}</span>:<a href={b.url}>{b.name}</a>}</>)}</nav>}</div><slot/></main><footer class="footer"><div class="container"><div class="footer-grid"><div class="footer-brand"><a class="logo" href="/"><span class="logo-icon" aria-hidden="true">翻</span><span class="logo-text">机场翻<small>JICHANGFAN</small></span></a><p>把复杂的网络服务，讲清楚。围绕机场推荐与 VPN 选择，提供有出处的资料和可操作的阅读指南。</p><span class="pill">官方资料 ≠ 本站实测</span></div><div><h2>探索内容</h2><a href="/recommend/">机场推荐</a><a href="/ranking/">机场排行榜</a><a href="/airport/">品牌资料库</a><a href="/compare/">横向比较工具</a></div><div><h2>阅读与学习</h2><a href="/guides/">使用教程</a><a href="/glossary/">知识百科</a><a href="/blog/">博客文章</a><a href="/sitemap-index.xml">Sitemap</a></div><div><h2>关于本站</h2><a href="/about/">关于我们</a><a href="/contact/">联系与纠错</a><a href="/editorial-policy/">编辑政策</a><a href="/privacy-policy/">隐私政策</a><a href="/disclaimer/">免责声明</a></div></div><div class="footer-bottom"><span>© 2026 机场翻 · jichangfan.shop</span><span>内容仅供研究与选择参考，使用服务请遵守所在地法律与服务条款。</span></div></div></footer><script>document.querySelector('.menu-button')?.addEventListener('click',()=>{const button=document.querySelector('.menu-button')!;const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));document.querySelector('#primary-nav')?.classList.toggle('open',open);});</script></body></html>

---
import {displayPlan,priceLabel,traffic,evidenceLabel,type Airport} from '../data/airports';
import Promotion from './Promotion.astro';
const {airport:a}=Astro.props as {airport:Airport};const p=displayPlan(a);
---
<article class="card brand-card"><div class="brand-head"><span class="brand-icon" style={'background:'+a.color} aria-hidden="true">{a.monogram}</span><div><h3><a href={'/airport/'+a.slug+'/'}>{a.name}</a></h3><small>{evidenceLabel(a)}</small></div></div><p class="brand-summary">{a.description}</p><div class="price">{priceLabel(p)}</div><div class="specs"><span>{traffic(p)}</span><span>{a.plans.length} 档套餐资料</span></div><a class="brand-detail" href={'/airport/'+a.slug+'/'}>资料与全部套餐 <span aria-hidden="true">↗</span></a><Promotion airport={a} compact/></article>

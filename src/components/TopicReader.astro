---
import type {TopicGuide} from '../data/reading-paths';
const {guide}=Astro.props as {guide:TopicGuide};
---
<section class="topic-reader" aria-labelledby="topic-answer">
  <div class="topic-reader-intro"><span class="eyebrow">READ WITH A PURPOSE / 从问题出发</span><h2 id="topic-answer">先找到你正在解决的问题</h2><p>{guide.answer}</p></div>
  <div class="table-wrap" role="region" tabindex="0" aria-label="本专题问题与阅读顺序"><table><thead><tr><th scope="col">你现在的情况</th><th scope="col">先核对什么</th><th scope="col">建议下一步</th></tr></thead><tbody>{guide.decisions.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>
  <h3>按这个顺序读</h3><ol class="reading-route">{guide.routes.map(link=><li><a href={link.url}>{link.title}<span aria-hidden="true">↗</span></a><p>{link.detail}</p></li>)}</ol>
  <p class="topic-takeaway">{guide.takeaway}</p>
</section>
<style>
 .topic-reader{margin:29px 0 45px;padding:33px;border:1px solid var(--line);background:#fffefb}.topic-reader-intro{max-width:900px}.topic-reader h2{font-size:27px;margin:10px 0 16px}.topic-reader p{font-size:14px;line-height:1.95}.topic-reader .table-wrap{margin:25px 0}.topic-reader h3{font-size:19px;margin:25px 0 18px}.reading-route{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:23px;list-style:none;counter-reset:route;padding:0}.reading-route li{counter-increment:route;border-top:1px solid var(--line);padding-top:17px}.reading-route li:before{content:'0' counter(route);font-family:Georgia,serif;color:var(--muted);font-size:18px}.reading-route a{display:flex;justify-content:space-between;gap:13px;margin-top:9px;font-weight:600;font-size:15px;line-height:1.8}.reading-route a:hover{text-decoration:underline}.reading-route li p{font-size:12px;color:var(--muted);margin-top:10px}.topic-takeaway{border-left:3px solid var(--forest);padding:12px 18px;background:#f2f3ec;margin-top:23px}@media(max-width:760px){.topic-reader{padding:25px}.reading-route{grid-template-columns:minmax(0,1fr);gap:14px}.reading-route li{display:grid;grid-template-columns:29px minmax(0,1fr);gap:0 10px}.reading-route li:before{grid-row:1/3}.reading-route a{margin-top:0}.reading-route li p{grid-column:2;margin-top:4px}}@media(max-width:600px){.topic-reader{padding:23px 20px}.topic-reader h2{font-size:23px;line-height:1.7}.topic-reader p{font-size:13px}.reading-route a{font-size:14px}.topic-reader .table-wrap table{min-width:620px}.topic-takeaway{padding:12px 14px}}
</style>

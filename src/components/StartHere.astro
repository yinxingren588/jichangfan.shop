---
const steps=[
 {title:'服务与设备',question:'你准备怎样使用？',answer:'先分清商业 VPN 与代理订阅，确认客户端支持自己的系统和配置格式。',label:'VPN 与代理订阅区别',url:'/blog/vpn-vs-proxy/'},
 {title:'费用与流量',question:'每月实际需要多少？',answer:'对齐付款总额、重置周期和节点倍率，再按预计用量计算支出。',label:'性价比机场成本计算',url:'/ranking/value/#cost-calculator'},
 {title:'节点与任务',question:'需要完成什么任务？',answer:'先核对节点地区与兼容条件，再在常用网络和时段观察具体任务。',label:'机场节点选择基础',url:'/glossary/node/'},
 {title:'订单与优惠',question:'付款前还缺什么资料？',answer:'确认优惠是否在订单生效，核对续费、退款和配额；未知项先补来源。',label:'品牌套餐与优惠码',url:'/coupons/'},
];
---
<section class="start-here" aria-labelledby="start-title"><div class="start-intro"><span class="eyebrow">BEFORE THE SHORTLIST / 选择之前</span><h2 id="start-title">机场推荐，先核对这四件事。</h2><p>把需求写清楚，再缩小候选。<a href="/recommend/beginner/">第一次选择，从这里开始 ↗</a></p></div><ol class="start-steps">{steps.map(step=><li><span class="start-label">{step.title}</span><h3>{step.question}</h3><p>{step.answer}</p><a href={step.url}>{step.label}<span aria-hidden="true">→</span></a></li>)}</ol></section>
<style>
 .start-here{padding:12px 0 42px;margin-bottom:10px;border-bottom:1px solid var(--line)}.start-intro{display:grid;grid-template-columns:1fr 1fr;gap:12px 30px;align-items:end}.start-intro .eyebrow{grid-column:1/-1}.start-intro h2{font-family:var(--serif);font-size:31px;letter-spacing:-.025em;line-height:1.6}.start-intro>p{font-size:12px;line-height:1.9;color:var(--muted);text-align:right}.start-intro>p a{display:block;color:var(--forest)}.start-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:27px;list-style:none;padding:0;margin:26px 0 0;counter-reset:step}.start-steps li{counter-increment:step;border-top:1px solid var(--line);padding-top:19px}.start-label{font-size:10px;color:var(--muted)}.start-label:before{content:'0' counter(step) ' / ';font-family:Georgia,serif;font-size:14px;color:var(--forest)}.start-steps h3{font-size:17px;line-height:1.8;margin:12px 0 10px}.start-steps p{font-size:12px;line-height:1.95;color:var(--muted);margin-bottom:17px}.start-steps a{display:flex;justify-content:space-between;gap:10px;font-size:11px;color:var(--forest);line-height:1.9}.start-steps a:hover{text-decoration:underline}@media(max-width:900px){.start-steps{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}}@media(max-width:600px){.start-here{padding:7px 0 31px}.start-intro{grid-template-columns:minmax(0,1fr);gap:8px}.start-intro h2{font-size:25px}.start-intro>p{text-align:left;font-size:11px}.start-intro>p a{display:inline-block;margin-left:6px}.start-steps{gap:22px 18px;margin-top:22px}.start-steps h3{font-size:14px;margin:9px 0}.start-steps p{font-size:11px}.start-steps a{font-size:10px}.start-label{font-size:9px}}
</style>

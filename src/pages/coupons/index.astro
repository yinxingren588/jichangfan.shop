---
import Base from '../../layouts/Base.astro';import {partnerAirports} from '../../data/airports';import Promotion from '../../components/Promotion.astro';import PlanTable from '../../components/PlanTable.astro';
const coupons=partnerAirports.filter(a=>a.coupon);
---
<Base title="机场优惠码与套餐汇总：29 个品牌的价格、流量与购买入口" description="汇总隐形人、微风网络、飞猫云、Firefly机场等29个品牌的58档套餐参考资料和12个站长提供的优惠码，区分月付、年付总额与年付折合月价。" breadcrumbs={[{name:'优惠码与套餐',url:'/coupons/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">COUPONS & PLANS</div><h1>优惠码、价格、流量，一起核对。</h1><p>29 个品牌 · 58 档参考套餐 · {coupons.length} 个站长提供的优惠码。参考价格来自节点推荐站，未在品牌结账页验证。优惠码折扣、有效期和适用套餐均待确认。</p><div class="meta"><time datetime="2026-10-21">整理于 2026-10-21</time><span>人民币原价参考，未计算优惠后金额</span></div></header><nav class="brand-jump" aria-label="跳到品牌套餐">{partnerAirports.map(a=><a href={'#'+a.slug}>{a.name}</a>)}</nav><section class="section"><h2>已有优惠码</h2><div class="coupon-directory">{coupons.map(a=><div class="card"><a class="text-link" href={'#'+a.slug}>{a.name} 套餐 ↓</a><Promotion airport={a} compact/></div>)}</div></section><section class="section"><h2>全部品牌与套餐</h2><p class="note">以下按站长提供的品牌顺序展示，不是速度或性价比排名。年付折合月价不能按月支付；不限时套餐的流量按总配额展示。</p>{partnerAirports.map(a=><article class="white-panel partner-detail" id={a.slug}><h3><a class="text-link" href={'/airport/'+a.slug+'/'}>{a.name} 套餐资料 ↗</a></h3><PlanTable airport={a}/><Promotion airport={a}/><p class="sources">参考来源：<a href={a.sources[0]} target="_blank" rel="noopener noreferrer">节点推荐站 · {a.name}</a>。<a href={'/review/'+a.slug+'/'}>阅读计费分析</a></p></article>)}</section><section class="prose"><h2>如何使用优惠码</h2><ol><li>复制品牌对应代码，通过该品牌入口查看当期套餐。</li><li>在付款前输入代码，确认订单是否明确显示优惠。</li><li>核对优惠后的支付总额、周期、续费价格和配额，再自行决定是否付款。</li></ol><p>本站不收款、不代下单。推广入口包含邀请参数，经此购买本站可能获得佣金；邀请参数本身不是优惠码。没有提供代码的品牌显示“未提供优惠码”。</p><p>第三方资料可能变化或存在错误；可通过<a href="/contact/">纠错渠道</a>提交带日期的公开来源。</p></section></div></Base>

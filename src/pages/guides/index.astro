---
import Base from '../../layouts/Base.astro';import ArticleList from '../../components/ArticleList.astro';import {guideTopics} from '../../data/guide-topics';import {site} from '../../data/site';import {getCollection} from 'astro:content';
const entries=(await getCollection('articles',({data})=>data.category==='guides'&&!data.draft)).sort((a,b)=>(a.data.order??999)-(b.data.order??999));
const groups=guideTopics.map(t=>{const ids=new Set<string>(t.ids);return {...t,entries:entries.filter(e=>ids.has(e.id))};});
const schema=[{'@context':'https://schema.org','@type':'ItemList',name:'机场翻使用教程',numberOfItems:entries.length,itemListElement:entries.map((e,i)=>({'@type':'ListItem',position:i+1,name:e.data.title,url:site.url+'/guides/'+e.id+'/'}))}];
---
<Base title={'使用教程'+entries.length+'篇：设备安装、订阅导入与连接排查'} description={'机场翻'+entries.length+'篇使用教程，按设备入门、配置导入、连接分流、故障排查、日常维护和隐私管理分组，提供操作步骤、结果检查、常见问题和官方参考。'} {schema} breadcrumbs={[{name:'使用教程',url:'/guides/'}]}><div class="container guide-directory"><header class="page-heading guide-heading"><div><div class="eyebrow">THE PRACTICAL HANDBOOK / 使用手册</div><h1>使用教程</h1><p>从设备准备，到日常维护。<br/>按自己的系统与遇到的问题开始，每一步都知道如何检查结果。</p><div class="meta"><span>{entries.length} 篇教程 · {groups.length} 个主题</span><time datetime="2026-10-21">更新于 2026-10-21</time></div></div><div class="guide-total" aria-hidden="true"><strong>{String(entries.length).padStart(2,'0')}</strong><span>篇使用教程<small>LEARN. CONNECT. UNDERSTAND.</small></span></div></header><nav class="topic-directory" aria-label="教程主题">{groups.map(t=><a href={'#'+t.id}>{t.name} <span>{t.entries.length}</span></a>)}</nav><p class="note">先确认教程适用的系统和客户端；具体入口与支持范围以当前官方帮助为准。通用方法与单一产品的操作会分别说明。</p>{groups.map(t=><section class="section guide-section" id={t.id} data-guide-group={t.id}><div class="section-heading"><div><h2><span class="section-index">{t.icon}</span>{t.name}</h2><p>{t.intro}</p></div><span class="guide-group-count">{t.entries.length} 篇</span></div><ArticleList entries={t.entries} numbered/></section>)}<nav class="page-nav"><a href="/recommend/">按需求选择 →</a><a href="/airport/">核对品牌资料 →</a><a href="/search/">搜索具体问题 →</a></nav></div></Base>

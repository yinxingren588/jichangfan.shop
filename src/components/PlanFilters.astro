<form class="plan-filters" id="plan-filters" aria-label="筛选品牌套餐">
  <div><label for="plan-brand">品牌名称</label><input id="plan-brand" type="search" name="brand" placeholder="例如：隐形人、Breezenet" autocomplete="off" /></div>
  <div><label for="plan-period">付款口径</label><select id="plan-period" name="period"><option value="all">全部付款方式</option><option value="month">月付</option><option value="year">年付总额</option><option value="year-equivalent">年付折合月价</option><option value="one-time">一次性付款</option></select></div>
  <label class="plan-coupon-filter" for="plan-has-coupon"><input id="plan-has-coupon" type="checkbox" name="coupon" />仅看有站长提供优惠码</label>
  <button type="reset" class="button secondary">清除筛选</button>
</form>
<p class="plan-filter-status" id="plan-filter-status" role="status" aria-live="polite">全部 29 个品牌 · 58 档套餐。优惠有效性仍需在订单页确认。</p>
<p class="note" id="plan-filter-empty" hidden>没有符合条件的套餐。可以清除品牌文字、切换付款方式或取消优惠码条件。</p>
<noscript><p class="note">启用 JavaScript 可筛选；下方仍完整列出所有品牌与套餐。</p></noscript>
<script>
 const form=document.querySelector<HTMLFormElement>('#plan-filters')!;
 const brand=document.querySelector<HTMLInputElement>('#plan-brand')!;
 const period=document.querySelector<HTMLSelectElement>('#plan-period')!;
 const coupon=document.querySelector<HTMLInputElement>('#plan-has-coupon')!;
 const panels=[...document.querySelectorAll<HTMLElement>('.partner-detail[data-plan-brand]')];
 function filterPlans(){
  const query=brand.value.trim().toLocaleLowerCase();let brands=0,plans=0;
  for(const panel of panels){
   const brandMatch=panel.dataset.planBrand!.includes(query)&&(!coupon.checked||panel.dataset.planCoupon==='yes');
   let matching=0;
   panel.querySelectorAll<HTMLTableRowElement>('tr[data-plan-period]').forEach(row=>{row.hidden=!brandMatch||(period.value!=='all'&&row.dataset.planPeriod!==period.value);if(!row.hidden)matching++;});
   panel.querySelectorAll<HTMLElement>('[data-plan-note-periods]').forEach(note=>{note.hidden=period.value!=='all'&&!note.dataset.planNotePeriods!.split(' ').includes(period.value);});
   panel.hidden=matching===0;
   if(matching){brands++;plans+=matching;}
  }
  document.querySelector('#plan-filter-status')!.textContent='找到 '+brands+' 个品牌 · '+plans+' 档套餐。优惠码是否生效仍需在订单页确认。';
  document.querySelector<HTMLElement>('#plan-filter-empty')!.hidden=brands>0;
 }
 form.addEventListener('submit',event=>{event.preventDefault();filterPlans();});
 form.addEventListener('input',filterPlans);
 form.addEventListener('change',filterPlans);
 form.addEventListener('reset',()=>queueMicrotask(filterPlans));
 document.querySelectorAll<HTMLAnchorElement>('.brand-jump a,.coupon-directory a[href^="#"]').forEach(link=>link.addEventListener('click',()=>{form.reset();filterPlans();}));
 filterPlans();
</script>
<style>
 .plan-filters{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr) auto auto;gap:19px;align-items:end;padding:25px;background:#f0f2e9;border:1px solid var(--line);margin:23px 0 15px}.plan-filters>div{min-width:0}.plan-filters>div>label{display:block;font-size:12px;margin-bottom:10px}.plan-filters input[type=search],.plan-filters select{width:100%;min-width:0;padding:12px;border:1px solid #89947f;background:#fff;border-radius:3px;color:var(--ink);font:inherit;font-size:13px;min-height:46px}.plan-coupon-filter{display:flex;align-items:center;gap:9px;font-size:11px;min-height:46px}.plan-coupon-filter input{width:16px;height:16px;accent-color:var(--forest)}.plan-filters button{font-size:11px;min-height:46px}.plan-filter-status{font-size:12px;line-height:1.9;margin-bottom:22px}.plan-filters input:focus-visible,.plan-filters select:focus-visible{outline:2px solid var(--forest);outline-offset:3px}@media(max-width:1000px){.plan-filters{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.plan-filters{grid-template-columns:minmax(0,1fr);gap:16px;padding:21px}.plan-coupon-filter{min-height:30px}.plan-filters button{justify-self:start}.plan-filter-status{font-size:11px}}
</style>

---
import Base from '../../layouts/Base.astro';
import {airports,evidenceLabel} from '../../data/airports';
import {brandEditorial} from '../../data/partners';
import {site} from '../../data/site';
import PlanTable from '../../components/PlanTable.astro';
import Promotion from '../../components/Promotion.astro';
import BrandDecision from '../../components/BrandDecision.astro';
export function getStaticPaths(){return airports.map(a=>({params:{slug:a.slug},props:{a}}));}
const {a}=Astro.props,e=brandEditorial[a.slug];
const headings=[['conclusion','选择结论'],['plans','价格、流量与优惠'],['analysis','逐档预算分析'],['nodes','线路与客户端'],['services','AI 与流媒体'],['pros','优势与限制'],['faq','本品牌常见问题'],['sources','资料来源']];
const related=e?e.related.map(slug=>airports.find(b=>b.slug===slug)!).filter(Boolean):airports.filter(b=>b.kind===a.kind&&b.id!==a.id).slice(0,3);
const schema=[{'@context':'https://schema.org','@type':'Article',headline:a.name+' 套餐分析',description:e?.focus||a.description,datePublished:site.date,dateModified:site.date,author:{'@id':site.url+'/#organization'},publisher:{'@id':site.url+'/#organization'},mainEntityOfPage:site.url+'/review/'+a.slug+'/',inLanguage:'zh-CN'}];
---
<Base title={a.name+' 套餐分析：价格、流量、优惠码与计费限制'} description={(e?.focus||a.description)+'。逐档比较费用、配额、设备数和付款周期，附预算算例与来源。'} schema={schema} breadcrumbs={[{name:'机场评测',url:'/review/'},{name:a.name+' 分析',url:'/review/'+a.slug+'/'}]}>
 <div class="container"><header class="page-heading"><div class="eyebrow">套餐分析 / {e?'站长确认价格与流量':'官方公开资料'}</div><h1>{a.name}：套餐事实与选择判断</h1><p>{e?.focus||a.description}</p><div class="meta"><span>机场翻</span><time datetime="2026-10-21">发布 / 更新：2026-10-21</time><span>{evidenceLabel(a)}</span></div></header>
 <div class="page-grid"><article class="prose">
 <h2 id="conclusion">选择结论</h2><blockquote><p>{e?.focus||a.conclusion}</p></blockquote><p>{e?`${a.name}的比较重点是付款周期、实际用量与设备组合。本文按站长确认的指定资料源整理价格和流量，预算情景为编辑演示；网络表现没有进行机场翻账户实测。`:a.conclusion}</p>
 <h2 id="plans">套餐价格、流量与优惠</h2><PlanTable airport={a}/>{a.affiliateUrl?<Promotion airport={a}/>:<p>本站未提供该品牌优惠码或推广入口，价格依据下方官方来源。</p>}
 <h2 id="analysis">逐档预算与选择分析</h2>{e?<BrandDecision airport={a}/>:a.analysis.map((p,i)=><><h3>{['计费与权益','使用边界','容易遗漏的条件'][i]}</h3><p>{p}</p></>)}
 <h2 id="nodes">节点、线路与客户端</h2><p>{a.line}</p><p>来源列示地区：{a.regions.join('、')||'完整列表尚未核实'}。协议及生态名称：{a.protocols.join('、')||'尚未核实'}。设备限制：{a.deviceLimit||'尚未核实'}。</p><p>{a.clients}</p>
 {e?.protocols.includes('V2Ray')&&<p>其中 V2Ray 是工具生态名称，实际传输协议、加密参数与订阅格式应从节点配置确认，不能仅凭这一字段判断客户端兼容。</p>}
 <p>首次配置可按设备阅读<a href="/guides/windows/">Windows</a>、<a href="/guides/macos/">macOS</a>、<a href="/guides/android/">Android</a>或<a href="/guides/ios/">iOS 教程</a>。先确认安装来源和订阅格式，再检查连通与断开恢复。</p>
 <h2 id="services">AI 与流媒体支持说明</h2>{e?<><p>指定资料页列示 AI：{e.aiClaims||'未列明'}；流媒体：{e.streamingClaims||'未列明'}。这些项目是来源声明，机场翻未逐项验证，也没有复用来源网站的评分、成功率或“零卡顿”描述作为结论。</p><p>如果某个平台是购买的主要目的，应确认所需账号地区、套餐节点权限与试用退款窗口，并保留具体节点和日期的观察记录。一次打开首页不足以证明全部功能可用。</p></>:<p>AI：{a.aiSupport?.join('；')||'尚未核实'}。流媒体：{a.streamingSupport?.join('；')||'尚未核实'}。公开权益不等于每个账号始终可用。</p>}
 <h2 id="pros">优势、限制与适用人群</h2><h3>资料中可以对照的部分</h3><ul>{a.advantages.map(p=><li>{p}</li>)}</ul><h3>影响购买决定的限制</h3><ul>{a.disadvantages.map(p=><li>{p}</li>)}</ul><p>{e?e.caseLabel.replace(/^以/,'').replace(/为例$/,'的读者可以先按上面的预算情景筛选。'):a.suitableFor.join('；')+'。'}个人设备并发不等于多人共享许可；团队使用需另外核对条款。</p>
 <h2 id="faq">本品牌常见问题</h2>{e?.faq.map(f=><><h3>{f.question}</h3><p>{f.answer}</p></>)}
 <h3>{a.name} 的优惠后价格怎么核对？</h3><p>{a.coupon?`复制站长提供的 ${a.coupon}，在所选套餐的结算页查看减免后的实付总额。折扣比例、有效期、首购与续费限制未提供明确条款，本文不据代码字符串推算优惠价。`:'站长未提供优惠码。邀请入口不等于优惠券，也不能据邀请参数推断折扣。按订单显示的套餐和付款金额核对。'}</p>
 <h3>如何与相近套餐比较？</h3><p>将本品牌<a href={'/compare/?brands='+a.slug}>加入比较工具</a>，再选择下方相近候选。对齐币种、付款周期和配额重置方式，最后比较所需地区、设备数及未明确的退款和倍率条件。</p>
 <h2 id="sources">资料来源与更新记录</h2><ul class="sources">{a.sources.map((s,i)=><li><a href={s} target="_blank" rel="noopener noreferrer">{e?'站长指定资料源':'官方来源'} {i+1}：{new URL(s).hostname}{new URL(s).pathname}</a></li>)}</ul><p>资料读取与整理：{a.lastVerified}。{e?'价格、流量由站长确认；规格和功能声明保留来源属性。':'价格与权益依据官方公开资料。'}页面金额未套用优惠码，服务条款变更后需重新核对。推广入口附近标明可能获得佣金，资料标准见<a href="/editorial-policy/">编辑政策</a>。</p>
 </article><aside><div class="side-panel toc"><h2>本页目录</h2>{headings.map(([id,name])=><a href={'#'+id}>{name}</a>)}<a class="button" href={'/compare/?brands='+a.slug} style="color:#fff;font-size:12px;margin-top:20px">加入比较 →</a><a href={'/airport/'+a.slug+'/'}>完整品牌字段 →</a></div></aside></div>
 <section class="related"><h2>相近套餐，继续比较</h2><p>按起步预算、配额或付款方式挑选阅读候选，以下次序不代表性能排名。</p><div class="page-nav">{related.map(b=><a href={'/review/'+b.slug+'/'}>{b.name} 资料分析 →</a>)}</div></section></div>
</Base>

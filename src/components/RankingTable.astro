---
import {airports,budgetOrder,monthlyPlan,money,traffic,completeness} from '../data/airports';
const {mode='budget'}=Astro.props;const rows=mode==='overall'?[...airports].sort((a,b)=>completeness(b)-completeness(a)||a.slug.localeCompare(b.slug)):budgetOrder();
---
<div class="table-wrap" tabindex="0" role="region" aria-label="品牌资料比较表，可横向滚动"><table><thead><tr><th scope="col">序号</th><th scope="col">品牌 / 类型</th><th scope="col">普通月付</th><th scope="col">流量口径</th><th scope="col">{mode==='overall'?'资料完备度':'适合人群'}</th><th scope="col">资料</th></tr></thead><tbody>{rows.map((a,i)=><tr><td><span class:list={['rank-num',{first:i===0}]}>{String(i+1).padStart(2,'0')}</span></td><td><strong>{a.name}</strong><small>{a.kind==='proxy'?'代理订阅':'商业 VPN'}</small></td><td>{money(monthlyPlan(a)!.price,monthlyPlan(a)!.currency)}</td><td>{traffic(monthlyPlan(a))}</td><td>{mode==='overall'?completeness(a)+'/5 项':a.suitableFor[0]}</td><td><a class="text-link" href={'/review/'+a.slug+'/'}>资料分析 ↗</a></td></tr>)}</tbody></table></div>

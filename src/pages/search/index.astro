---
import Base from '../../layouts/Base.astro';import {blogTopics} from '../../data/blog-topics';import {topicGuides} from '../../data/reading-paths';import {topics} from '../../data/topics';import {getCollection} from 'astro:content';import {airports} from '../../data/airports';
const entries=await getCollection('articles',({data})=>!data.draft);
const resources=[...blogTopics.map(topic=>({title:topicGuides[topic.id].title,description:topicGuides[topic.id].description,url:'/blog/topics/'+topic.id+'/'})),...topics.map(topic=>({title:topic.title,description:topic.description+topic.subtitle,url:'/recommend/'+topic.slug+'/'})),{title:'套餐成本计算器：月付、年付与流量倍率',description:'按付款总额、周期、配额与预计用量核算支出。',url:'/ranking/value/#cost-calculator'},{title:'机场优惠码与套餐汇总',description:'29个品牌、58档套餐和12个站长提供的优惠码。',url:'/coupons/'},{title:'机场与VPN横向比较',description:'选择2–4个品牌，对照价格、流量与计费条件。',url:'/compare/'}];
---
<Base title="站内搜索：查找教程、知识与品牌资料" description="搜索机场翻的教程、知识百科、选择指南与品牌套餐资料。" noindex breadcrumbs={[{name:'站内搜索',url:'/search/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">FIND YOUR ANSWER</div><h1>从一个问题，找到答案。</h1><p>输入品牌、设备或术语，例如“Windows”“倍率”“VPN”。搜索在当前浏览器完成。</p></header><form role="search"><label for="query">搜索文章与品牌</label><input id="query" name="q" type="search" class="search-input" placeholder="输入关键词…" autocomplete="off"/><button class="button" type="submit">搜索</button></form><p class="status-message" role="status" id="result-count" style="margin-top:20px">输入关键词筛选内容；下方为全部可搜索条目。</p><div class="article-list" id="search-results">{[...resources,...entries.map(e=>({title:e.data.title,description:e.data.description,url:'/'+e.data.category+'/'+e.id+'/'})),...airports.map(a=>({title:a.name,description:a.description,url:'/airport/'+a.slug+'/'}))].map(item=><article class="article-row" data-search={(item.title+' '+item.description).toLocaleLowerCase()}><div><h2 style="font-size:17px"><a href={item.url}>{item.title}</a></h2><p>{item.description}</p></div></article>)}</div><p class="empty" id="no-results" hidden>没有找到匹配内容，请试试更短的词或品牌英文名。</p></div><script>const input=document.querySelector<HTMLInputElement>('#query')!;const items=Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));function search(){const q=input.value.trim().toLocaleLowerCase();let n=0;items.forEach(item=>{item.hidden=!!q&&!item.dataset.search!.includes(q);if(!item.hidden)n++;});document.querySelector('#result-count')!.textContent='找到 '+n+' 个结果';document.querySelector<HTMLElement>('#no-results')!.hidden=n>0;const url=new URL(location.href);if(q)url.searchParams.set('q',input.value.trim());else url.searchParams.delete('q');history.replaceState(null,'',url.pathname+url.search);}input.value=new URL(location.href).searchParams.get('q')||'';input.addEventListener('input',search);document.querySelector('form')!.addEventListener('submit',event=>{event.preventDefault();search();});search();</script></Base>

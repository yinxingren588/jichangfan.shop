---
import Base from '../../layouts/Base.astro';import ArticleList from '../../components/ArticleList.astro';import {getCollection,render} from 'astro:content';import {site} from '../../data/site';
export async function getStaticPaths(){const entries=await getCollection('articles',({data})=>!data.draft);return entries.map(entry=>({params:{category:entry.data.category,slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const names:Record<string,string>={guides:'使用教程',blog:'博客文章',glossary:'知识百科'};const all=await getCollection('articles',({data})=>!data.draft);const related=all.filter(a=>a.id!==entry.id).map(a=>({entry:a,score:a.data.tags.filter(t=>entry.data.tags.includes(t)).length})).sort((a,b)=>b.score-a.score||a.entry.id.localeCompare(b.entry.id)).slice(0,3).map(a=>a.entry);
const schema=[{'@context':'https://schema.org','@type':'BlogPosting',headline:entry.data.title,description:entry.data.description,datePublished:entry.data.date,dateModified:entry.data.updated,author:{'@id':site.url+'/#organization'},publisher:{'@id':site.url+'/#organization'},mainEntityOfPage:site.url+'/'+entry.data.category+'/'+entry.id+'/',inLanguage:'zh-CN'}];
---
<Base title={entry.data.title} description={entry.data.description} schema={schema} date={entry.data.updated} breadcrumbs={[{name:names[entry.data.category],url:'/'+entry.data.category+'/'},{name:entry.data.title,url:'/'+entry.data.category+'/'+entry.id+'/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">{names[entry.data.category]} / 机场翻</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="meta"><span>机场翻</span><time datetime={entry.data.date}>发布 {entry.data.date}</time><time datetime={entry.data.updated}>更新 {entry.data.updated}</time></div></header><div class="page-grid"><article class="prose"><Content/><h2 id="official-sources">官方资料来源</h2><ul class="sources">{entry.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></li>)}</ul><p class="note">本文为编辑解释与通用检查方法。软件界面、产品价格和支持情况可能变化，具体操作以当前官方帮助为准。核验日期：{entry.data.updated}。</p></article><aside><div class="side-panel toc"><h2>本文目录</h2>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}<a href="#official-sources">官方资料来源</a><div class="page-nav"><a href="/recommend/beginner/">新手选择 →</a><a href="/compare/">品牌比较 →</a></div></div></aside></div><section class="section related"><div class="section-heading"><h2>接着读，理解更完整</h2><a href={'/'+entry.data.category+'/'}>返回{names[entry.data.category]} ↗</a></div><ArticleList entries={related}/></section></div></Base>

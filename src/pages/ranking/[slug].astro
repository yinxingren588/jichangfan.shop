---
import Base from '../../layouts/Base.astro';import CostCalculator from '../../components/CostCalculator.astro';import RankingTable from '../../components/RankingTable.astro';import {airports,unitCost,money} from '../../data/airports';import {site} from '../../data/site';
export function getStaticPaths(){return ['overall','budget','value','stable'].map(slug=>({params:{slug}}));}const slug=Astro.params.slug!;const names:Record<string,string>={overall:'综合资料榜：按官方资料完备度排序',budget:'低预算机场与 VPN：美元普通月付价格榜',value:'性价比机场：每 GB 成本与流量倍率核算',stable:'稳定性排行榜方法：实测记录与入榜标准'};const descs:Record<string,string>={overall:'五项官方资料分别计数，第三方参考不计为已核实价格；公开缺失项，不将资料换成测速分数。',budget:'只纳入已核实的美元普通月付，升序展示；服务类型不同，性能不作推断。',value:'用套餐成本计算器对齐月付、年付、总量配额与倍率，再按预计用量核算每 GB 成本；附公式与虚构算例。',stable:'本站没有跨日实测记录，暂不公布稳定性名次。这里给出可复查的观察与入榜办法。'};
const list=slug==='overall'?[...airports].sort((a,b)=>{const score=(x:typeof a)=>[x.plans.some(p=>p.verified),!!x.deviceLimit,x.protocols.length>0,x.regions.length>0,x.sources.length>0].filter(Boolean).length;return score(b)-score(a)||a.slug.localeCompare(b.slug);}):airports.filter(a=>a.currency==='USD').sort((a,b)=>a.startingPrice!-b.startingPrice!);
const schema=['overall','budget'].includes(slug)?[{'@context':'https://schema.org','@type':'ItemList',name:names[slug],itemListElement:list.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:site.url+'/review/'+a.slug+'/'}))}]:[];
---
<Base title={names[slug]} description={descs[slug]+'数据核验于 2026-10-21，附来源和比较限制。'} schema={schema} breadcrumbs={[{name:'机场排行',url:'/ranking/'},{name:names[slug].split('：')[0],url:'/ranking/'+slug+'/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">透明数据 / 公开规则</div><h1>{names[slug]}</h1><p>{descs[slug]}</p><div class="meta"><time datetime="2026-10-21">资料更新 2026-10-21</time><span>无本站实测数据</span></div></header>
{['overall','budget'].includes(slug)&&<><RankingTable mode={slug}/><section class="prose" style="margin-top:25px"><h2>快速结论与排名依据</h2>{slug==='overall'?<><p>每个品牌按五项资料各计 1 项：已核实套餐价格、设备限制、协议说明、地区信息、可追溯来源；总计 5 项。同分按品牌英文标识排序。这里衡量的是本站当前资料覆盖程度，不能判断服务速度、安全性或实际可用性。</p><p>地区列表未完整核验的品牌不补写国家数量。协议清单和设备条款缺失时保持空值，待有官方证据再补充。资料完整的服务仍可能不适合你的网络。</p></>:<><p>只有套餐已核实、币种为 USD、付款周期为 month 的方案参与本榜。按各品牌最先收录的普通月付方案金额升序；不纳入免费层、地区自选组合、优惠券和年付折算价格。</p><p>Mullvad 的欧元价格不参与美元榜；若将来增加汇率换算，应注明汇率来源、时间和换算方式。价格顺序不能解释为不同产品之间的性价比结论。</p></>}<h2>适合人群与进一步阅读</h2><p>预算敏感的用户先看每个品牌的付款口径；首次使用者还需查看客户端与设备限制。每行“资料分析”提供优缺点、尚未核实字段和资料来源。进入<a href="/compare/">对比工具</a>可同时观察多个维度。</p><h2>数据来源与更新</h2><p>所有显示金额来自统一品牌数据库。点击<a href="/airport/">品牌资料页</a>可打开对应官方定价、公告或明确标注的第三方参考。核验日期为 2026-10-21；价格变化后需重新核验，结账金额以服务商为准。条款未核实不等于不存在限制。</p></section></>}
{slug==='value'&&<><CostCalculator/><div class="white-panel"><h2>标称成本参考表</h2><p class="note">以下只计算价格 ÷ 页面标称 GB，按套餐名称排列，未按成本排名。倍率尚未完整核实，因此“实际每 GB 成本”全部保留待核实。不将不限量套餐算作每 GB 为零。</p><div class="table-wrap" tabindex="0" role="region" aria-label="标称流量成本参考"><table><thead><tr><th>套餐</th><th>月付</th><th>标称配额</th><th>标称价格 / GB</th><th>实际成本</th></tr></thead><tbody>{airports.flatMap(a=>a.plans.filter(p=>p.verified&&p.period==='month'&&p.trafficGB).map(p=><tr><td><a href={'/review/'+a.slug+'/'}>{a.name} {p.name}</a></td><td>{money(p.price,p.currency)}</td><td>{p.trafficGB} GB</td><td>{p.currency} {(p.price/p.trafficGB!).toFixed(5)}</td><td>{unitCost(p)===undefined?'尚未核实':unitCost(p)?.toFixed(5)}</td></tr>))}</tbody></table></div></div><article class="prose" style="margin-top:25px"><h2>真正的每 GB 成本怎么算</h2><p>实际可用流量 = 标称配额 ÷ 流量倍率；每 GB 成本 = 套餐价格 ÷ 实际可用流量。如果同一订阅存在多种倍率，还需要按照你的使用比例估算，不能给整个套餐统一套用最低倍率。</p><h2>一个明确的算术例子</h2><p>假设某套餐月付 20 元、标称 100GB、所用节点均为 2 倍率，则实际可传输约 50GB，每 GB 约 0.4 元。这是解释公式的假设例子，不是本网站收录品牌的真实套餐。</p><h2>入榜与排除条件</h2><ul><li>价格、配额、付款周期和倍率都有证据后才参与实际成本排序。</li><li>年付需独立展示全年总价和流量重置周期，不与月付混排。</li><li>不限时套餐按总量和有效期单独比较；不当成每月都有新配额。</li><li>不限量 VPN 不生成虚假的零成本每 GB。</li></ul><h2>为什么还没有实际性价比名次</h2><p>目前可核验价格和标称流量来自 Just My Socks 官方订购页，但不同节点的倍率并未完整核实。其他品牌的配额口径不同或未核实，因此本次不填实际成本名次。你可以先读<a href="/glossary/traffic-multiplier/">流量倍率百科</a>，再到<a href="/compare/">横向比较</a>核对条件。</p><h2>来源</h2><p><a href="https://www.justmysocks.net/members/cart.php" rel="noopener noreferrer" target="_blank">Just My Socks 官方订购页</a>（核验 2026-10-21）。TB 到 GB 按十进制展示，实际计量单位仍以服务后台为准。</p></article></>}
{slug==='stable'&&<article class="prose"><h2>快速结论：当前没有稳定性名次</h2><p>本站尚未购买套餐开展跨日网络测试。不能用商家在线率、用户评论或一次测速生成稳定性总分。本页先提供测试记录标准，后续有完整数据再补充结果。</p><h2>观察条件必须一致</h2><ol><li>记录日期、时区、地区、运营商、宽带规格、设备、系统和客户端版本。</li><li>分别覆盖工作日、周末、低峰和常用高峰，保留连续观察时长。</li><li>固定节点和协议，改变条件后新开一组记录。</li><li>记录连接成功率、断线、恢复时间、延迟分布和丢包，保留失败样本。</li></ol><h2>发布结果需要什么证据</h2><p>原始日志应做脱敏，剔除账户令牌与真实用户地址，同时保留采样时间和测试方法。每次报告都应说明样本范围；一条宽带的结果不能代表所有地区或运营商。</p><h2>先查故障，再决定续费</h2><p>查看服务商公开状态页，记录故障公告时间和处理过程。没有公开状态资料也不代表没有故障。可访问<a href="https://mullvad.net/en/servers" target="_blank" rel="noopener noreferrer">Mullvad 服务器页</a>与<a href="https://www.ivpn.net/status" target="_blank" rel="noopener noreferrer">IVPN 状态页</a>理解资料形式；这些是官方状态，不是本站的可用率测量。</p><h2>相关入口</h2><p>先读<a href="/recommend/stable/">稳定优先的选择方法</a>；连接异常可从<a href="/guides/troubleshooting/">排查教程</a>开始。若只关心月度费用，请使用<a href="/ranking/budget/">预算榜</a>，不要把价格排序当作质量排序。</p></article>}
<nav class="page-nav" aria-label="其他榜单">{['overall','budget','value','stable'].filter(s=>s!==slug).map(s=><a href={'/ranking/'+s+'/'}>{names[s].split('：')[0]} →</a>)}</nav></div></Base>

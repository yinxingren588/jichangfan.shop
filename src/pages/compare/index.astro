---
import Base from '../../layouts/Base.astro';import {airports} from '../../data/airports';import {compareFields} from '../../data/compare';
---
<Base title="机场与 VPN 横向比较工具：价格、流量、优惠码与计费周期" description="选择2–4个品牌比较套餐价格、月度流量、一次性配额和优惠码，区分官方资料、站长确认的指定资料源、年付总额与年付折合月价。" breadcrumbs={[{name:'机场对比',url:'/compare/'}]}><div class="container"><header class="page-heading"><div class="eyebrow">COMPARE BEFORE YOU CHOOSE</div><h1>把选择，放在同一张表里。</h1><p>选择 2–4 个候选品牌。人民币、美元与欧元按原币展示；价格未套用优惠码；人民币套餐价格与流量由站长确认，采用指定资料源。</p></header><div class="page-nav"><a href="/coupons/">29 个品牌完整套餐与优惠码 →</a></div><noscript><p class="note">当前未启用 JavaScript，下方仍可阅读完整静态数据表。选择候选品牌需要启用 JavaScript。</p></noscript><fieldset style="border:0;padding:0;margin:0"><legend>添加候选品牌（最多 4 家）</legend><div class="compare-picker">{airports.map(a=><label><input type="checkbox" value={a.slug} name="brand"/>{a.name}</label>)}</div></fieldset><p id="compare-status" class="status-message" role="status" aria-live="polite">选择至少 2 家后开始比较。</p><div id="compare-empty" class="empty" hidden>还差一个候选品牌。选择至少 2 家，最多 4 家。</div><div id="compare-table" class="table-wrap" tabindex="0" role="region" aria-label="品牌横向对比表，可横向滚动"><table class="compare-table"><thead><tr><th scope="col">比较维度</th>{airports.map(a=><th scope="col">{a.name}</th>)}</tr></thead><tbody>{compareFields.map(([label,format])=><tr><th scope="row">{label}</th>{airports.map(a=><td>{format(a)}</td>)}</tr>)}<tr><th scope="row">来源与分析</th>{airports.map(a=><td><a class="text-link" href={'/review/'+a.slug+'/'}>{a.name} 分析 →</a></td>)}</tr><tr><th scope="row">推广入口</th>{airports.map(a=><td>{a.affiliateUrl?<><a href={a.affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">前往 {a.name} ↗</a><small>推广链接，本站可能获得佣金</small></>:'本站未提供推广入口'}</td>)}</tr></tbody></table></div><p class="note">展示套餐优先使用已收录的普通月付；仅有年付的品牌显示年付总额。年付折合月价只在对应档位注明，不能当作可按月购买的价格。流量重置、退款与优惠适用条件需在下单前确认。</p></div><script>
import {airports} from '../../data/airports';import {compareFields} from '../../data/compare';
const boxes=Array.from(document.querySelectorAll<HTMLInputElement>('input[name=brand]'));const status=document.querySelector('#compare-status')!;const empty=document.querySelector<HTMLElement>('#compare-empty')!;const container=document.querySelector<HTMLElement>('#compare-table')!;
function update(){
 const selected=boxes.filter(b=>b.checked).map(b=>b.value);status.textContent='已选择 '+selected.length+' / 4 家'+(selected.length<2?'；请再添加候选品牌。':'；可在表头移除品牌。');empty.hidden=selected.length>=2;container.hidden=selected.length<2;
 const url=new URL(location.href);if(selected.length)url.searchParams.set('brands',selected.join(','));else url.searchParams.delete('brands');history.replaceState(null,'',url.pathname+url.search);
 const brands=selected.map(s=>airports.find(a=>a.slug===s)!);const table=document.createElement('table');table.className='compare-table';const head=table.createTHead().insertRow();const first=document.createElement('th');first.scope='col';first.textContent='比较维度';head.append(first);
 brands.forEach(a=>{const th=document.createElement('th');th.scope='col';const name=document.createElement('div');name.textContent=a.name;const remove=document.createElement('button');remove.className='remove-brand';remove.textContent='移除';remove.setAttribute('aria-label','移除 '+a.name);remove.addEventListener('click',()=>{const box=boxes.find(b=>b.value===a.slug)!;box.checked=false;update();box.focus();});th.append(name,remove);head.append(th);});
 const body=table.createTBody();compareFields.forEach(([label,format])=>{const row=body.insertRow();const th=document.createElement('th');th.scope='row';th.textContent=label;row.append(th);brands.forEach(a=>row.insertCell().textContent=format(a));});
 for(const promo of [false,true]){const row=body.insertRow();const th=document.createElement('th');th.scope='row';th.textContent=promo?'推广入口':'来源与分析';row.append(th);brands.forEach(a=>{const cell=row.insertCell();if(promo&&!a.affiliateUrl){cell.textContent='本站未提供推广入口';return;}const link=document.createElement('a');link.href=promo?a.affiliateUrl!:'/review/'+a.slug+'/';link.className='text-link';link.textContent=promo?'前往 '+a.name+' ↗':'阅读 '+a.name+' 分析 →';if(promo){link.target='_blank';link.rel='sponsored nofollow noopener noreferrer';}cell.append(link);if(promo){const note=document.createElement('small');note.textContent='推广链接，本站可能获得佣金';cell.append(note);}});}
 container.replaceChildren(table);
}
boxes.forEach(box=>box.addEventListener('change',()=>{if(boxes.filter(b=>b.checked).length>4){box.checked=false;status.textContent='最多比较 4 家，请先移除一个候选品牌。';return;}update();}));
const initial=new URL(location.href).searchParams.get('brands')?.split(',')||[];const valid=[...new Set(initial)].filter(s=>airports.some(a=>a.slug===s)).slice(0,4);boxes.forEach(b=>b.checked=valid.includes(b.value));update();
</script></Base>

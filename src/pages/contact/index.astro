---
import Base from '../../layouts/Base.astro';
import {site} from '../../data/site';
const emailLink=(subject:string)=>'mailto:'+site.email+'?subject='+encodeURIComponent(subject);
const enquiries=[
 {number:'01',title:'内容纠错与资料更新',description:'发现套餐价格、流量、优惠信息或文章说明发生变化，欢迎提供最新资料，帮助我们保持内容准确。',details:'请附上本站页面地址、需要调整的内容、资料来源及查看日期。',subject:'机场翻｜内容纠错与资料更新',action:'提交资料纠错'},
 {number:'02',title:'品牌与商务合作',description:'欢迎就品牌资料补充、内容合作及商务事宜与我们沟通。请简要介绍品牌或机构，以及希望开展的合作。',details:'建议说明合作目标、具体范围与联系人。合作内容按照编辑政策核对，并清楚披露推广关系。',subject:'机场翻｜品牌与商务合作',action:'咨询合作事宜'},
 {number:'03',title:'网站体验与使用反馈',description:'遇到页面显示异常、链接无法打开或操作问题，可以将具体情况发给我们。你的反馈有助于改善阅读与使用体验。',details:'请说明页面地址、设备与浏览器、出现问题的步骤；如附截图，请先遮盖个人信息。',subject:'机场翻｜网站体验反馈',action:'反馈网站问题'},
];
const schema=[{'@context':'https://schema.org','@type':'ContactPage','@id':site.url+'/contact/#webpage',url:site.url+'/contact/',name:'联系我们 · 机场翻',description:'机场翻的内容纠错、品牌合作与网站反馈联系邮箱。',mainEntity:{'@id':site.url+'/#organization'},inLanguage:'zh-CN'}];
---
<Base title="联系我们：内容纠错、品牌合作与网站反馈" description="通过 yinxingren588@gmail.com 联系机场翻，提交内容纠错与套餐资料更新、咨询品牌合作或反馈网站使用问题。" schema={schema} breadcrumbs={[{name:'联系我们',url:'/contact/'}]}>
 <div class="container contact-page">
  <header class="page-heading"><div class="eyebrow">CONTACT / 与机场翻联系</div><h1>联系我们</h1><p>关于内容、合作与网站体验，欢迎与机场翻联系。<br/>请在邮件中说明来意与相关页面，便于我们准确核对和回复。</p></header>
  <section class="contact-panel" aria-labelledby="contact-email-title">
   <div><span class="eyebrow">联系邮箱</span><h2 id="contact-email-title"><a class="contact-email" href={'mailto:'+site.email}>{site.email}</a></h2><p>内容纠错、合作咨询与网站反馈，均可发送至此邮箱。</p></div>
   <div class="contact-actions"><div class="actions"><a class="button" href={emailLink('机场翻｜联系咨询')}>写邮件 <span aria-hidden="true">↗</span></a><button class="button secondary" type="button" id="copy-contact-email" data-email={site.email} hidden>复制邮箱</button></div><p id="contact-copy-status" class="contact-status" role="status" aria-live="polite">点击“写邮件”使用你的邮件应用，也可直接复制邮箱地址。</p></div>
  </section>
  <section class="section contact-topics" aria-labelledby="contact-topics-title"><div class="section-heading"><div><span class="eyebrow">HOW WE CAN HELP</span><h2 id="contact-topics-title">选择与你相关的联系事项</h2></div></div>
   <div class="catalog-grid">{enquiries.map(item=><article class="card contact-card"><span class="contact-number" aria-hidden="true">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p><p class="contact-details">{item.details}</p><a class="text-link" href={emailLink(item.subject)}>{item.action} <span aria-hidden="true">↗</span></a></article>)}</div>
  </section>
  <article class="prose contact-notes"><h2>让沟通更高效</h2><ol><li><strong>写清主题：</strong>建议使用“资料纠错”“品牌合作”或“网站反馈”，并附上相关品牌或文章名称。</li><li><strong>提供必要信息：</strong>说明问题发生的位置、需要核对的内容和可供参考的资料；功能问题请附简要复现步骤。</li><li><strong>先遮盖敏感内容：</strong>请勿发送账号密码、验证码、订阅链接、私钥或完整支付凭证；截图中的个人信息请先脱敏。</li></ol>
   <h2>关于回复与服务范围</h2><p>我们会在阅读并核对信息后回复，复杂事项可能需要补充资料。请以实际邮件回复为准，暂不承诺固定响应时限。</p><p>机场翻提供网络服务资料整理、使用教程与选择分析。套餐购买、账户使用、付款或退款事项，请直接联系对应服务商，以便由有权限处理的渠道跟进。</p><p>资料核对、合作披露与内容更新的具体原则，详见<a href="/editorial-policy/">编辑政策</a>；个人信息相关说明见<a href="/privacy-policy/">隐私政策</a>。</p>
  </article>
 </div>
</Base>
<script>
 const copyButton=document.querySelector<HTMLButtonElement>('#copy-contact-email');
 if(copyButton){copyButton.hidden=false;copyButton.addEventListener('click',async()=>{const status=document.querySelector('#contact-copy-status');try{await navigator.clipboard.writeText(copyButton.dataset.email!);if(status)status.textContent='邮箱已复制：'+copyButton.dataset.email;}catch{if(status)status.textContent='自动复制不可用，请选择上方邮箱地址手动复制。';}});}
</script>
<style>
 .contact-page>.page-heading{max-width:850px}.contact-page>.page-heading h1{line-height:1.45}
 .contact-panel{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:45px;align-items:center;padding:42px 44px;background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--forest);margin:0 0 58px}
 .contact-panel .eyebrow{display:block;margin-bottom:15px}.contact-panel h2{font-size:clamp(23px,2.65vw,36px);letter-spacing:-.04em;margin:0 0 17px}.contact-email{overflow-wrap:anywhere}.contact-panel p{font-size:13px;color:var(--muted);margin:0}.contact-actions .actions{margin:0;gap:12px}.contact-actions .button{font-size:12px;padding:12px 17px;min-height:46px;justify-content:center}.contact-actions .contact-status{font-size:11px;line-height:1.9;margin-top:17px;min-height:42px}
 .contact-topics .catalog-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.contact-card{display:flex;flex-direction:column}.contact-number{font-family:Georgia,serif;font-size:30px;color:#73816b;display:block;margin-bottom:20px}.contact-card h3{font-size:21px;margin-bottom:19px}.contact-card p{font-size:13px}.contact-card .contact-details{color:var(--muted);font-size:12px}.contact-card .text-link{margin-top:auto;padding-top:13px;font-size:12px}.contact-notes{max-width:900px;margin-bottom:30px}.contact-notes>h2:first-child{margin-top:0}
 @media(max-width:1050px){.contact-panel{grid-template-columns:minmax(0,1fr);gap:25px;padding:32px}.contact-actions .contact-status{min-height:0}.contact-card h3{font-size:19px}.contact-panel h2{font-size:32px}}
 @media(max-width:760px){.contact-topics .catalog-grid{grid-template-columns:minmax(0,1fr)}.contact-panel{margin-bottom:38px;padding:27px 23px;gap:23px}.contact-panel h2{font-size:clamp(20px,5.4vw,30px);line-height:1.6;letter-spacing:-.04em}.contact-panel p{font-size:12px}.contact-card h3{font-size:20px}.contact-card p{font-size:13px}.contact-number{font-size:27px;margin-bottom:17px}.contact-card .text-link{font-size:12px}.contact-page>.page-heading h1{font-size:clamp(28px,6vw,38px)}}
</style>
